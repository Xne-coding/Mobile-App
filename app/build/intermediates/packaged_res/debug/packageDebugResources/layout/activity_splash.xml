<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash: brand gradient, logo circle, app name, tagline, three pulsing dots.
  Java fades in splash_content and then routes to onboarding, login, or main.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_blue_gradient">

    <!-- Decorative circles -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.12"
        android:background="@drawable/bg_avatar_circle" />

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="80dp"
        android:layout_marginStart="-60dp"
        android:alpha="0.12"
        android:background="@drawable/bg_avatar_circle" />

    <!-- Content -->
    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo ring -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_white_rounded">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🗺️"
                android:textSize="44sp" />
        </FrameLayout>

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="QuestLearn"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:fontFamily="sans-serif" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="EXPLORE · LEARN · CONNECT"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif" />

        <!-- Loader dots -->
        <LinearLayout
            android:id="@+id/loader_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center_horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:alpha="0.4"
                android:background="@drawable/bg_avatar_circle" />

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:alpha="0.4"
                android:background="@drawable/bg_avatar_circle" />

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:alpha="0.4"
                android:background="@drawable/bg_avatar_circle" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
