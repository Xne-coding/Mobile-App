<?xml version="1.0" encoding="utf-8"?>
<!--
  QR scanner: dark chrome, CameraX preview, dim overlay + frame, manual code button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scanRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111111">

    <!-- Back, title, flash (torch) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#1A1A1A">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Scan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="sans-serif" />

        <FrameLayout
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_flash_btn">

            <ImageView
                android:id="@+id/flashIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flash"
                android:contentDescription="Flash toggle" />
        </FrameLayout>
    </LinearLayout>

    <!-- Preview + placeholder until camera starts + drawing overlay + hint at bottom -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Shown until the camera preview is bound -->
        <View
            android:id="@+id/cameraBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#222222" />

        <!-- QR Frame overlay -->
        <com.questlearn.QrOverlayView
            android:id="@+id/qrOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Hint text -->
        <TextView
            android:id="@+id/tvScanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="24dp"
            android:text="Point camera at a QR code"
            android:textSize="13sp"
            android:textColor="#99FFFFFF"
            android:fontFamily="sans-serif" />

    </FrameLayout>

    <!-- Bottom bar: type a code if camera isn't practical -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp"
        android:background="#111111">

        <!-- Opens alert dialog in Java -->
        <Button
            android:id="@+id/btnManualEntry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Enter Code Manually"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/bg_manual_btn"
            android:fontFamily="sans-serif" />

    </LinearLayout>

</LinearLayout>
