<?xml version="1.0" encoding="utf-8"?>
<!--
  One past voucher in Rewards history: type, date, hint to tap, amount on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVoucherType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="£5 Voucher"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvVoucherDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 Apr 2026"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to view QR code"
            android:textSize="11sp"
            android:textColor="@color/blue_primary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVoucherAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="£5.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/green_primary" />

</LinearLayout>
