<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown after redeeming or reopening a voucher: title, instructions, QR ImageView, code text, date.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvVoucherTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="£5 Voucher"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Present this QR code at checkout"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/ivQrCode"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:scaleType="fitCenter"
        android:background="@color/white"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvVoucherCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QL5-000000-XXXX"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvVoucherDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
