<?xml version="1.0" encoding="utf-8"?>
<!--
  Challenge detail: hero with icon and XP, distance line, mini map, steps list, begin button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/challengeDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Gradient header: navigation, challenge title, optional profile shortcut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_blue_gradient"
        android:paddingBottom="24dp"
        android:clipChildren="false">

        <!-- Back, title, profile icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Challenge Details"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#E6FFFFFF"
                android:fontFamily="sans-serif" />

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_person"
                app:tint="@android:color/white"
                android:contentDescription="Profile" />

        </LinearLayout>

        <!-- Large emoji / icon for this challenge -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_challenge_badge">

            <TextView
                android:id="@+id/tvChallengeIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📚"
                android:textSize="36sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvChallengeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="Clifton Quest:\nLibrary Discovery"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvChallengeOrg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="🏛️ Clifton Library · NTU Clifton"
            android:textSize="12sp"
            android:textColor="#BFFFFFFF"
            android:layout_marginBottom="14dp" />

        <!-- XP chip, difficulty, duration style chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 QR Scan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_hero_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvXpChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 150 XP"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_hero_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 45 min"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_hero_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- About, steps, map, rewards — scrolls above the fixed bottom button -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Description / what you'll do -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABOUT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    android:letterSpacing="0.07"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore key learning spaces around Clifton Library and unlock challenge clues across the NTU Clifton campus. Scan QR codes at 4 checkpoints to complete the route."
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingMultiplier="1.6" />

            </LinearLayout>

            <!-- RecyclerView of item_step (filled in code) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEPS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    android:letterSpacing="0.07"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

            <!-- Distance text + link to open main Map tab -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCATION"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    android:letterSpacing="0.07"
                    android:layout_marginBottom="8dp" />

                <!-- Custom drawn fake map (MiniMapView), not Google Maps -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/miniMapCard"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <com.questlearn.MiniMapView
                        android:id="@+id/miniMap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvOpenMap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:text="Open Map →"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_primary"
                        android:background="@drawable/bg_white_rounded"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:elevation="4dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="📍 Calculating distance…"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <!-- XP you'll earn for finishing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REWARDS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    android:letterSpacing="0.07"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardElevation="2dp"
                        app:cardCornerRadius="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡" android:textSize="24sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="150" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XP POINTS" android:textSize="9sp" android:textColor="?android:attr/textColorSecondary" android:letterSpacing="0.05" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardElevation="2dp"
                        app:cardCornerRadius="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏅" android:textSize="24sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BADGE" android:textSize="9sp" android:textColor="?android:attr/textColorSecondary" android:letterSpacing="0.05" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardElevation="2dp"
                        app:cardCornerRadius="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center" android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥" android:textSize="24sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+1" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STREAK" android:textSize="9sp" android:textColor="?android:attr/textColorSecondary" android:letterSpacing="0.05" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Begin challenge → ScanActivity, or disabled text when already completed -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBeginChallenge"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="📷  Scan Next QR Code"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/green_primary"
        android:fontFamily="sans-serif"
        app:cornerRadius="28dp"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
