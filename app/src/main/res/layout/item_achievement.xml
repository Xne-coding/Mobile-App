<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/achIconContainer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_ach_icon">

        <TextView
            android:id="@+id/tvAchIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🗺️"
            android:textSize="20sp" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campus Navigator"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/grey_900"
            android:fontFamily="@font/roboto"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvAchDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visited 10 unique locations on campus"
            android:textSize="11sp"
            android:textColor="@color/grey_500"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAchXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+200 XP earned"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/blue_primary" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvAchStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅"
        android:textSize="20sp" />

</LinearLayout>
