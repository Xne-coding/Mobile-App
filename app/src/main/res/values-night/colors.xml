<?xml version="1.0" encoding="utf-8"?>
<!--
  Neutral greys for dark mode so layouts that use @color/grey_* stay readable on dark backgrounds.
  Brand colors (blue, green, red, white for on-primary text) are unchanged in the base values/colors.xml.
-->
<resources>
    <color name="grey_50">#121212</color>
    <color name="grey_100">#1E1E1E</color>
    <color name="grey_200">#2C2C2C</color>
    <color name="grey_300">#3D3D3D</color>
    <color name="grey_400">#8A8A8A</color>
    <color name="grey_500">#B0B0B0</color>
    <color name="grey_600">#C4C4C4</color>
    <color name="grey_700">#D6D6D6</color>
    <color name="grey_800">#E8E8E8</color>
    <color name="grey_900">#F0F0F0</color>
</resources>
